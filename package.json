{
  "name": "horizon-forge",
  "version": "1.6.2",
  "description": "Horizon Forge — Auto Battler game API",
  "type": "module",
  "main": "api/server.js",
  "scripts": {
    "dev": "concurrently -n API,CLIENT -c cyan,magenta \"node --watch api/server.js\" \"npm run dev --prefix client\"",
    "dev:api": "node --watch api/server.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm --prefix client install --include=dev && npm run build --prefix client",
    "start": "node api/server.js",
    "migrate": "curl -s -X POST -H \"x-admin-secret: ${ADMIN_SECRET}\" http://localhost:3000/api/migrate | node -e \"process.stdin.resume();let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>console.log(JSON.parse(d)))\"",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@hiveio/dhive": "^1.3.6",
    "@neondatabase/serverless": "^0.10.4",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
