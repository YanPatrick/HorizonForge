# ─────────────────────────────────────────────────────────────────────────────
# Horizon Forge — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Required. Neon PostgreSQL connection string.
# Get from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required. Secret key used to sign JWT session tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# WARNING: if unset, a random key is generated on each restart and all active
# sessions are instantly invalidated (server logs a warning on startup).
AUTH_SECRET=

# ── Hive payments ─────────────────────────────────────────────────────────────
# Required for wagered matches. If either var is unset, the server rejects
# any join_queue with wager > 0 and /api/version returns { hivePay: false }
# so the client hides paid wager options automatically.

# Hive account that receives wagers and sends prizes (e.g. horizonforge)
HIVE_GAME_ACCOUNT=

# Active private key for HIVE_GAME_ACCOUNT. Used to broadcast HIVE transfers.
# Keep this secret — exposure allows draining the game account.
HIVE_ACTIVE_KEY=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Required for /api/migrate and /api/admin/* endpoints.
# Pass as header: x-admin-secret: <value>
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, admin endpoints return 503.
ADMIN_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
# Optional. HTTP port (default: 3000)
PORT=3000

# Optional. Set to 'production' for stricter CORS and sanitized error responses.
NODE_ENV=development
