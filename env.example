# ─────────────────────────────────────────────────────────
# Horizon Forge — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# Neon PostgreSQL connection string
# Get from: https://console.neon.tech → your project → Connection Details
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/horizon_forge?sslmode=require

# Server port (optional — defaults to 3000)
PORT=3000

# URL pública do frontend em produção (usado para restringir CORS)
# Ex: https://horizonforge.com
# Em dev sem esta variável, localhost:5173 e localhost:3000 são permitidos automaticamente.
CLIENT_URL=
