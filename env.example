# ─────────────────────────────────────────────────────────
# Horizon Forge — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# Neon PostgreSQL connection string
# Get from: https://console.neon.tech → your project → Connection Details
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/horizon_forge?sslmode=require

# Server port (optional — defaults to 3000)
PORT=3000

# URL pública do frontend em produção (usado para restringir CORS)
# Ex: https://horizonforge.com
# Em dev sem esta variável, localhost:5173 e localhost:3000 são permitidos automaticamente.
CLIENT_URL=

# Server-side secret used to sign session tokens (HMAC-SHA256, 24h TTL).
# REQUIRED in production — without it the server generates an ephemeral
# secret on every restart, invalidating every active session.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Hive game account that holds wagers and pays out prizes.
# Leave both blank to disable wagered (paid) PvP — only Free matches will be allowed.
HIVE_GAME_ACCOUNT=
HIVE_ACTIVE_KEY=

# Secret required for admin endpoints (POST /api/migrate, /api/admin/*).
# REQUIRED — without this set, the migrate and admin endpoints return 503.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET=

# Set to "production" in prod so the server serves the React build from public/dist
# and skips the dev fallback to public/index.html.
NODE_ENV=development
